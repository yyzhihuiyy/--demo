# Copy to backend/.env. Do not commit real credentials.
# Relative database path resolves from backend/, not the caller's working directory.
DATABASE_URL=sqlite:///./data/platform.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
